env {
  TMPDIR = "\${TMPDIR:-\${NXF_TEMP:-\$(mktemp -d)}}"
  APPTAINER_DISABLE_CACHE = "True"

  CMD_OUTRIDER_FRASER = "apptainer exec ${projectDir}/containers/rna_outliers_hg19hg38.sif"
  CMD_MAE = "apptainer exec ${projectDir}/containers/mae.sif"
  CMD_REPORT= "apptainer exec ${projectDir}/containers/report.sif"
}

process {
    executor="slurm"
    errorStrategy = 'ignore'
    containerOptions = "--bind ${projectDir}"

    // FRASER counting: retry on SLURM out-of-memory / time-limit kills (resources
    // grow with task.attempt in fraser.nf) and stop the run on any other failure.
    // 'ignore' would silently drop a sample and leave FRASER without input.
    withName: 'FraserSplitCount|FraserMergeSplit|FraserNonSplitCount|FraserFinalize' {
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
    withName: 'OutriderQC' {
        errorStrategy = { params.outrider.qcStopOnFail ? 'terminate' : 'ignore' }
    }

}
params {
    genomeBuild = "hg19"
    RbundelBioconductor = "R-bundle-Bioconductor/3.20-foss-2024a-R-4.4.2" // Niet in gebruik?
    featurecounts {
        genes_gtf="/groups/umcg-gdio/tmp02/projects/pid/resources_tim/resources/gtf/gencode.v34lift37.annotation.gtf"
    }
    extcounts {
        folder="/groups/umcg-gdio/tmp02/projects/pid/resources_tim/resources/counts/blood--hg19--gencode34"
        amount_outrider=100
        amount_fraser=100
    }
    samplesheet="/groups/umcg-gdio/tmp02/umcg-tniemeijer/rna/runs/run_3_frasersplit/samplesheet_pid.tsv"
    fastafolder="/apps/data/1000G/phase1/"
    fasta="phase1/human_g1k_v37_phiX.fasta.gz" 
    output="/groups/umcg-gdio/tmp02/umcg-tniemeijer/rna/runs/run_3_frasersplit"
    
    fraser {
        splitCountR="${projectDir}/fraser/fraser_split_count.R"
        mergeSplitR="${projectDir}/fraser/fraser_merge_split.R"
        nonSplitCountR="${projectDir}/fraser/fraser_nonsplit_count.R"
        finalizeR="${projectDir}/fraser/fraser_finalize.R"
        minExpressionInOneSample=20 // FRASER default: intron needs >= 20 split reads in one sample
        frasercountsR="${projectDir}/fraser/frasercounts.R" // single-job counting
        mergescriptR="${projectDir}/fraser/merge_counts.R"
        fraserR="${projectDir}/fraser/fraser.R"
        strandedCounting=false // use the strandSpecific column of the samplesheet (with extcounts.amount_fraser=0 or stranded external counts).
    }
    outrider {
        qcScript="${projectDir}/outrider/outrider_qc.py"
        qcPython="python3"   // plain python3 on the node
        qcStopOnFail=false   // true: stop the run when a sample fails the input QC
        outridercountsR="${projectDir}/outrider/featurecounts.R"
        mergecountsR="${projectDir}/outrider/mergecounts.R"
        outriderDatasetR="${projectDir}/outrider/create_outrider_dataset.R"
        outriderOptimR="${projectDir}/outrider/outrider_optim.R"
        mergeQFiles="${projectDir}/outrider/merge_qfiles.R"
        outriderR="${projectDir}/outrider/outrider.R"
    }
    mae {
        resultsR="${projectDir}/MAE/get_MAE_results.R"
        annotateGeneR="${projectDir}/MAE/get_gene_annotations.R"
    }
    report {
        htmlTemplate="${projectDir}/html_report/template.html" 
        embedScript="${projectDir}/html_report/embed_data.py"
    }
    
}
workDir="${params.output}/work"
