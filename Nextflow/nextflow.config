env {
  TMPDIR = "\${TMPDIR:-\${NXF_TEMP:-\$(mktemp -d)}}"
  APPTAINER_DISABLE_CACHE = "True"

  CMD_LEAFCUTTER = "na"
  CMD_OUTRIDER_FRASER = "apptainer exec ${projectDir}/containers/rna_outliers_hg19hg38.sif"
  CMD_MAE = "apptainer exec ${projectDir}/containers/mae.sif"
  CMD_REPORT= "apptainer exec ${projectDir}/containers/report.sif"
}

process {
    executor="slurm"
    errorStrategy = 'ignore'
    containerOptions = "--bind ${projectDir}"

    withName: 'OutriderQC' {
        errorStrategy = { params.outrider.qcStopOnFail ? 'terminate' : 'ignore' }
    }

    withName: 'FraserSplitCount|FraserMergeSplit|FraserNonSplitCount|FraserFinalize|FraserPrepareQ|FraserOptimQ' {
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
}
params {
    annotation {
        script="${projectDir}/annotation/gtf_to_gene_annotation.py"
        python="python3"    // plain python3 (standard library only, >= 3.6) on the node
        biotypesFraser="protein_coding" // gene types FRASER junctions are annotated with ("all" for every gene)
    }
    featurecounts {
        genes_gtf="/groups/umcg-gdio/tmp02/projects/pid/resources_tim/resources/gtf/gencode.v34lift37.annotation.gtf"
    }
    extcounts {
        folder="/groups/umcg-gdio/tmp02/projects/pid/resources_tim/resources/counts/blood--hg19--gencode34"
        amount_outrider=100
        amount_fraser=100
    }
    samplesheet="/groups/umcg-gdio/tmp02/umcg-tniemeijer/rna/runs/run_4_deseq/samplesheet_pid.tsv"
    fastafolder="/apps/data/1000G/phase1/"
    fasta="phase1/human_g1k_v37_phiX.fasta.gz" 
    output="/groups/umcg-gdio/tmp02/umcg-tniemeijer/rna/runs/run_4_deseq"
    
    fraser {
        splitCountR="${projectDir}/splicing/fraser/fraser_split_count.R"
        mergeSplitR="${projectDir}/splicing/fraser/fraser_merge_split.R"
        nonSplitCountR="${projectDir}/splicing/fraser/fraser_nonsplit_count.R"
        finalizeR="${projectDir}/splicing/fraser/fraser_finalize.R"
        // false: count FRASER unstranded (required when unstranded external counts are merged in).
        // true: use the strandSpecific column of the samplesheet (only with extcounts.amount_fraser=0 or stranded external counts).
        strandedCounting=false
        minExpressionInOneSample=20 // FRASER default: intron needs >= 20 split reads in one sample
        mergescriptR="${projectDir}/splicing/fraser/merge_counts.R"
        prepareQR="${projectDir}/splicing/fraser/fraser_prepare_q.R"
        optimQR="${projectDir}/splicing/fraser/fraser_optim_q.R"
        fraserR="${projectDir}/splicing/fraser/fraser_fit.R" // fit + results; the old fraser.R (search + fit in one job) is kept for reference
    }
    outrider {
        qcScript="${projectDir}/expression/outrider/outrider_qc.py"
        qcPython="python3"   // plain python3 on the node
        qcStopOnFail=false   // true: stop the run when a sample fails the input QC
        outridercountsR="${projectDir}/expression/outrider/featurecounts.R"
        mergecountsR="${projectDir}/expression/outrider/mergecounts.R"
        outriderDatasetR="${projectDir}/expression/outrider/create_outrider_dataset.R"
        outriderOptimR="${projectDir}/expression/outrider/outrider_optim.R"
        mergeQFiles="${projectDir}/expression/outrider/merge_qfiles.R"
        outriderR="${projectDir}/expression/outrider/outrider.R"
    }
    leafcutter {
        enabled=false            // LeafcutterMD outlier splicing (needs containers/leafcutter.sif, see leafcutter.def)
        minSamples=10           // LeafcutterMD compares a sample with the others: skipped below this number of samples
        sjScript="${projectDir}/splicing/leafcutter/sj_to_junc.py"
        splitToJuncR="${projectDir}/splicing/leafcutter/fraser_split_to_junc.R"
        splitScript="${projectDir}/splicing/leafcutter/leafcutter_split_counts.py"
        resultsScript="${projectDir}/splicing/leafcutter/leafcutter_results.py"
        dir="/opt/leafcutter"   // LeafCutter location inside the container
        countMultiMapping=false // also count multi-mapping reads of SJ.out.tab
        maxIntronLen=100000
        minCluReads=30
        minCluRatio=0.001
        chunks=20               // clusters are tested in this many parallel jobs
        maxClusterSize=50
        minCoverage=20
        timeout=30
        padj=0.1                // Benjamini-Hochberg cut-off for the result tables
    }
    deseq2 {
        enabled=true            // differential expression between the samplesheet groups (needs a "group" column)
        script="${projectDir}/expression/deseq2/deseq2.R"
        reference=""            // reference (denominator) group; empty = all pairwise comparisons
        covariates=""           // comma separated samplesheet columns to correct for, e.g. "sex,batch"
        minCount=10             // genes with fewer total reads are dropped
    }
    mae {
        resultsR="${projectDir}/MAE/get_MAE_results.R"
        annotateGeneR="${projectDir}/MAE/get_gene_annotations.R"
    }
    report {
        htmlTemplate="${projectDir}/html_report/template.html" 
        embedScript="${projectDir}/html_report/embed_data.py"
    }
    
}
workDir="${params.output}/work"
